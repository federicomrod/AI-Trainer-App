# Copy this file to .env (same folder) and fill in your real key(s).
# .env is git-ignored -- it never gets committed.

# Which provider answers the one planner call. Default is openai.
# HYBRID_COACH_PROVIDER=openai

# Needed for the default provider (openai).
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# Only needed if you set HYBRID_COACH_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
